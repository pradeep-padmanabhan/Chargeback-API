root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_prefer_braces = when_multiline

# Logging message templates must be constant: interpolated templates bypass structured
# property redaction (PAN masking) and are therefore forbidden.
dotnet_diagnostic.CA2254.severity = error
# Structured logging templates must match argument counts.
dotnet_diagnostic.CA2017.severity = error

[tests/**/*.cs]
# Test method names use underscores for readability.
dotnet_diagnostic.CA1707.severity = none
